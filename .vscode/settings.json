{
  "editor.formatOnSave": true,
  "stylua.targetReleaseVersion": "latest",
  "files.eol": "\n",
  "files.exclude": {
    "**/*-lock.*": false,
    "**/*.lock": false,
    "**/*.lock.*": false,
    "**/*_packages/**": false,
    "**/.luaurc": false,
    "**/.pesde/**": false,
    "**/pesde.toml": false,
    ".env": false,
    ".gitattributes": false,
    ".github": false,
    ".gitignore": false,
    ".vscode": false,
    "rokit.toml": false,
    "mise.toml": false,
    "stylua.toml": false
  },
  "files.readonlyInclude": {
    "**/*-lock.*": true,
    "**/*.lock": true,
    "**/*.lock.*": true,
    "**/*_packages/**": true,
    "**/.pesde/**": true
  },
  "luau-lsp.platform.type": "standard",
  "luau-lsp.sourcemap.enabled": false,
  "luau-lsp.plugin.enabled": false,
  "luau-lsp.bytecode.vectorCtor": "create",
  "luau-lsp.bytecode.vectorLib": "vector",
  "luau-lsp.bytecode.vectorType": "vector",
  "luau-lsp.completion.imports.ignoreGlobs": [
    "**/.pesde/**"
  ],
  "luau-lsp.completion.imports.requireStyle": "alwaysRelative",
  "luau-lsp.completion.imports.stringRequires.enabled": true,
  "luau-lsp.fflags.enableNewSolver": false,
  "luau-lsp.ignoreGlobs": [
    "**/.pesde/**",
    "**/*_packages/**"
  ]
}